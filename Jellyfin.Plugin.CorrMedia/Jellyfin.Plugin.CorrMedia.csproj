<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.CorrMedia</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\jellyfin-source\MediaBrowser.Controller\MediaBrowser.Controller.csproj')">
    <DefineConstants>$(DefineConstants);PATCHED_CORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" Condition="!Exists('..\jellyfin-source\MediaBrowser.Controller\MediaBrowser.Controller.csproj')" />
    <ProjectReference Include="..\jellyfin-source\MediaBrowser.Controller\MediaBrowser.Controller.csproj" Condition="Exists('..\jellyfin-source\MediaBrowser.Controller\MediaBrowser.Controller.csproj')" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" Condition="!Exists('..\jellyfin-source\MediaBrowser.Controller\MediaBrowser.Controller.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
